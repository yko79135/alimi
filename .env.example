# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/SUPABASE_SETUP.md for how to obtain each Supabase value.

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. NEVER expose to the browser
# or commit a real value — see docs/SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
# Public base URL of this deployment, used to build absolute links in
# emails/push notifications (e.g. https://app.alimi.example).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Web Push (VAPID) -----------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=
